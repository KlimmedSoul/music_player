# --- доступ к самому бэкенду (пароль на экране логина фронта) ---
# Задай собственный пароль перед запуском.
AUTH_PASSWORD=

# --- Spotify (бесплатное приложение: developer.spotify.com) ---
# Redirect URI в конфиге приложения: http://localhost:8080/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/auth/spotify/callback

# --- VK: user-токен (аудио доступно только user-токеном, см. README) ---
VK_TOKEN=

# --- SoundCloud: токен из devtools (см. README) ---
SOUNDCLOUD_OAUTH_TOKEN=
SOUNDCLOUD_CLIENT_ID=

# --- сервер ---
PORT=8080
# Постоянный случайный ключ; пусто — новый ключ при каждом запуске.
JWT_SECRET=
MEDIA_CACHE_DIR=./cache/media
MEDIA_CACHE_LIMIT_MB=10240

# --- Spotify: долгоживущий refresh-токен (опционально, для облака) ---
SPOTIFY_REFRESH_TOKEN=

# --- YouTube Music: cookies браузера (music.youtube.com), см. README ---
# локально: путь к cookies.txt; в облаке: base64 всего файла (base64 -w0 cookies.txt)
YTM_COOKIES_FILE=
YTM_COOKIES_B64=
